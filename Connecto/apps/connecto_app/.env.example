# Connecto — Environment Variables Template
#
# Copy this file to .env and fill in the values for your installation.
# NEVER commit the real .env file to version control.
#
# ─────────────────────────────────────────────────────────────────
# SECURITY NOTE: All secrets below must be rotated before first use.
# Generate strong random values using:
#   openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────

# HMAC secret used by the relay to authenticate connections.
# Must be a cryptographically random base64 string (≥ 32 bytes).
# Generated automatically by the Connecto Mac app — do not set manually
# unless you are running a headless relay.
# CONNECTO_SECRET=

# Password for the P12/PFX certificate bundle (if used).
# Leave empty if you generated the certificate without a passphrase.
# P12_PASSWORD=

# WebSocket relay server port.
# Default: 8080. Change only if port 8080 is unavailable on your Mac.
CONNECTO_WS_PORT=8080
